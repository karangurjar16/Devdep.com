{
    "name": "@repo/upload",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "tsc -b && node dist/index.js",
        "build": "bunx --bun prisma generate && tsc -b",
        "start": "node dist/index.js",
        "lint": "eslint .",
        "type-check": "tsc --noEmit",
        "db:generate": "bunx --bun prisma generate",
        "db:migrate": "bunx --bun prisma migrate dev"
    },
    "dependencies": {
        "@repo/shared": "workspace:*",
        "@repo/redis": "workspace:*",
        "@repo/aws": "workspace:*",
        "@prisma/adapter-pg": "^7.1.0",
        "@prisma/client": "^6.19.1",
        "@aws-sdk/client-s3": "^3.750.0",
        "@aws-sdk/lib-storage": "^3.750.0",
        "axios": "^1.13.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "pg": "^8.16.3",
        "redis": "^5.10.0",
        "simple-git": "^3.30.0"
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@repo/tsconfig": "workspace:*",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^22.0.0",
        "@types/pg": "^8.16.0",
        "eslint": "^9.39.1",
        "prisma": "^6.19.1",
        "typescript": "^5.9.3"
    }
}